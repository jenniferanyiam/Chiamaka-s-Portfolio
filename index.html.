<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Chiamaka Salome is a creative content creator specializing in content writing, storytelling, social media content, scriptwriting and AI video creation.">
  <title>Chiamaka Salome | Content Creator</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #101010;
      --surface: #191919;
      --gold: #d8b779;
      --white: #f7f4ee;
      --muted: #b3b0a9;
      --border: rgba(216, 183, 121, 0.22);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 85px;
    }

    body {
      background: var(--bg);
      color: var(--white);
      font-family: "DM Sans", sans-serif;
      line-height: 1.7;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      max-width: 100%;
      display: block;
    }

    .container {
      width: min(1120px, 90%);
      margin: auto;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: rgba(16, 16, 16, 0.96);
      border-bottom: 1px solid var(--border);
    }

    nav {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .logo {
      font-family: "Playfair Display", serif;
      font-size: 1.45rem;
      font-weight: 700;
    }

    .logo span {
      color: var(--gold);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 26px;
      list-style: none;
      font-size: 0.9rem;
    }

    .nav-links a:hover {
      color: var(--gold);
    }

    .menu-toggle {
      display: none;
      background: transparent;
      color: var(--white);
      border: 1px solid var(--border);
      padding: 8px 12px;
      border-radius: 6px;
      font-size: 1rem;
      cursor: pointer;
    }

    .hero {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
      gap: 65px;
      padding-top: 85px;
      padding-bottom: 100px;
    }

    .eyebrow {
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 3px;
      font-size: 0.75rem;
      font-weight: 700;
    }

    h1, h2, h3 {
      font-family: "Playfair Display", serif;
      line-height: 1.2;
    }

    h1 {
      font-size: clamp(2.8rem, 5vw, 4.8rem);
      margin: 20px 0;
    }

    h1 span, .gold {
      color: var(--gold);
    }

    .hero p {
      color: var(--muted);
      max-width: 530px;
      margin-bottom: 30px;
    }

    .buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }

    .btn {
      display: inline-block;
      padding: 12px 22px;
      border: 1px solid var(--gold);
      border-radius: 4px;
      font-weight: 600;
      transition: 0.2s;
    }

    .btn-primary {
      background: var(--gold);
      color: #15120c;
    }

    .btn:hover {
      transform: translateY(-2px);
      opacity: 0.9;
    }

    .hero-image {
      position: relative;
      max-width: 440px;
      justify-self: end;
    }

    .hero-image::before {
      content: "";
      position: absolute;
      top: 18px;
      right: -18px;
      width: 100%;
      height: 100%;
      border: 1px solid var(--gold);
      z-index: 0;
    }

    .hero-image img {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 520px;
      object-fit: cover;
      object-position: center top;
      border-radius: 3px;
    }

    section {
      padding: 85px 0;
    }

    .section-heading {
      text-align: center;
      max-width: 700px;
      margin: 0 auto 45px;
    }

    .section-heading h2 {
      font-size: clamp(2rem, 4vw, 3rem);
      margin: 12px 0;
    }

    .section-heading p {
      color: var(--muted);
    }

    .about {
      background: var(--surface);
    }

    .about-grid {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      align-items: center;
      gap: 60px;
    }

    .about-image img {
      width: 100%;
      height: 440px;
      object-fit: cover;
      object-position: center top;
      border-radius: 4px;
    }

    .about-text h2 {
      font-size: clamp(2rem, 4vw, 3rem);
      margin: 12px 0 22px;
    }

    .about-text p {
      color: var(--muted);
      margin-bottom: 16px;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .service-card {
      padding: 28px;
      background: var(--surface);
      border: 1px solid var(--border);
      transition: 0.25s;
    }

    .service-card:hover {
      transform: translateY(-5px);
      border-color: var(--gold);
    }

    .service-number {
      color: var(--gold);
      font-size: 0.85rem;
      letter-spacing: 2px;
    }

    .service-card h3 {
      font-size: 1.35rem;
      margin: 18px 0 12px;
    }

    .service-card p {
      color: var(--muted);
      font-size: 0.94rem;
    }

    .portfolio {
      background: var(--surface);
    }

    .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 22px;
    }

    .project {
      padding: 30px;
      background: var(--bg);
      border: 1px solid var(--border);
    }

    .project-tag {
      color: var(--gold);
      text-transform: uppercase;
      font-size: 0.75rem;
      letter-spacing: 2px;
    }

    .project h3 {
      font-size: 1.5rem;
      margin: 12px 0;
    }

    .project p {
      color: var(--muted);
      margin-bottom: 16px;
    }

    .project a {
      color: var(--gold);
      font-weight: 600;
    }

    .process-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      text-align: center;
    }

    .process-item {
      padding: 20px 12px;
    }

    .process-item .number {
      width: 45px;
      height: 45px;
      border: 1px solid var(--gold);
      border-radius: 50%;
      display: grid;
      place-items: center;
      color: var(--gold);
      margin: 0 auto 18px;
    }

    .process-item h3 {
      margin-bottom: 10px;
    }

    .process-item p {
      color: var(--muted);
      font-size: 0.9rem;
    }

    .contact {
      background: var(--surface);
      text-align: center;
    }

    .contact-content {
      max-width: 700px;
      margin: auto;
    }

    .contact h2 {
      font-size: clamp(2.2rem, 4vw, 3.4rem);
      margin: 15px 0;
    }

    .contact p {
      color: var(--muted);
      margin-bottom: 25px;
    }

    .contact-details {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 15px 25px;
      margin: 30px 0;
      overflow-wrap: anywhere;
    }

    .contact-details a:hover {
      color: var(--gold);
    }

    footer {
      padding: 25px 0;
      text-align: center;
      color: var(--muted);
      font-size: 0.85rem;
    }

    footer span {
      color: var(--gold);
    }

    @media (max-width: 800px) {
      .hero {
        grid-template-columns: 1fr;
        gap: 45px;
        padding-top: 60px;
      }

      .hero-image {
        justify-self: center;
        width: min(100%, 440px);
      }

      .hero-image img {
        height: 460px;
      }

      .about-grid {
        grid-template-columns: 1fr;
        gap: 35px;
      }

      .about-image {
        max-width: 450px;
      }

      .services-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .process-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .nav-links {
        display: none;
        position: absolute;
        top: 76px;
        left: 0;
        width: 100%;
        padding: 22px 5%;
        background: var(--bg);
        border-bottom: 1px solid var(--border);
        flex-direction: column;
        align-items: flex-start;
        gap: 18px;
      }

      .nav-links.open {
        display: flex;
      }

      .menu-toggle {
        display: block;
      }
    }

    @media (max-width: 520px) {
      .services-grid,
      .portfolio-grid {
        grid-template-columns: 1fr;
      }

      section {
        padding: 65px 0;
      }

      .hero-image img {
        height: 390px;
      }

      .about-image img {
        height: 350px;
      }

      .process-grid {
        gap: 10px;
      }
    }
  </style>
</head>

